<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📚 Get Your Success"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btn_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📖 My Notes"
        android:textSize="16sp"
        android:layout_margin="8dp" />

    <Button
        android:id="@+id/btn_tests"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✏️ Take Test"
        android:textSize="16sp"
        android:layout_margin="8dp" />

    <Button
        android:id="@+id/btn_study_planner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📅 Study Planner"
        android:textSize="16sp"
        android:layout_margin="8dp" />

    <Button
        android:id="@+id/btn_performance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📊 Performance"
        android:textSize="16sp"
        android:layout_margin="8dp" />

    <Button
        android:id="@+id/btn_start_lockdown"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔒 Start Lockdown Mode"
        android:textSize="16sp"
        android:layout_margin="8dp"
        android:backgroundTint="#FF6B6B" />

</LinearLayout>